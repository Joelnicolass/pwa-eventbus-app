    "axios": "^1.11.0",
    "react": "19.1.0",
    "react-native": "0.81.1",
    "react-native-safe-area-context": "^5.6.1",
    "react-native-vision-camera": "^4.7.1",
    "react-native-webview": "^13.16.0"
  },
  "devDependencies": {
