{
  "name": "pocorbith",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "sync-pwa": "cp -r pwa_build/* android/app/src/main/assets/www/ && cp -r pwa_build/* ios/pocorbith/www/",
